// API key CRUD lifecycle: create, list (redacted), revoke, delete

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create API key
post("$baseUrl/api/v1/api-keys", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "Test Key" })
})
.expect(status: 201)
.assert({
  expect: [
    this.body.name eq "Test Key",
    this.body.key neq null
  ]
})
.store({ "$$keyId": this.body.id, "$$keyValue": this.body.key })

// List API keys — key field must be null (redacted)
get("$baseUrl/api/v1/api-keys", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)

// Revoke the key
post("$baseUrl/api/v1/api-keys/$$keyId/revoke", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.ok eq true] })

// Delete the key
delete("$baseUrl/api/v1/api-keys/$$keyId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.ok eq true] })
