// Login with valid credentials and verify session
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Use the token to access /me — 200 proves the session is valid
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
