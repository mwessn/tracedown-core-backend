// Login three times, revoke all others from the third
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$tokenA": this.body.token })

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$tokenB": this.body.token })

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$tokenC": this.body.token })

// Revoke all others from C
delete("$baseUrl/api/v1/auth/sessions", {
  headers: { Authorization: "Bearer $$tokenC" }
})
.expect(status: 200)

// C should still work
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$tokenC" }
})
.expect(status: 200)

// A and B should be revoked
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$tokenA" }
})
.expect(status: 401)

get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$tokenB" }
})
.expect(status: 401)
