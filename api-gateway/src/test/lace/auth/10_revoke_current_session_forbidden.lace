// Revoking the current session via DELETE /sessions/{id} should return 403
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Get sessions to find current session ID
get("$baseUrl/api/v1/auth/sessions", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
