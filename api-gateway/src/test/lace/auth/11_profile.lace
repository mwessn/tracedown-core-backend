// Profile management: update display name

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Get current profile
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.user.displayName eq "Admin"] })

// Update display name
patch("$baseUrl/api/v1/auth/profile", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ displayName: "Super Admin" })
})
.expect(status: 200)
.assert({ expect: [this.body.displayName eq "Super Admin"] })

// Verify on /me
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.user.displayName eq "Super Admin"] })

// Empty display name rejected
patch("$baseUrl/api/v1/auth/profile", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ displayName: "" })
})
.expect(status: 400)
