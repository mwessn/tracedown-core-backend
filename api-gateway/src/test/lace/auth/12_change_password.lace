// Change password flow

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$memberEmail", password: "$memberPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Wrong current password
post("$baseUrl/api/v1/auth/change-password", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ currentPassword: "WrongPass1!", newPassword: "NewPass123!" })
})
.expect(status: 400)

// Weak new password
post("$baseUrl/api/v1/auth/change-password", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ currentPassword: "$memberPassword", newPassword: "weak" })
})
.expect(status: 400)

// Successful change
post("$baseUrl/api/v1/auth/change-password", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ currentPassword: "$memberPassword", newPassword: "ChangedPass1!" })
})
.expect(status: 200)

// Login with new password works
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$memberEmail", password: "ChangedPass1!" })
})
.expect(status: 200)

// Old password no longer works
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$memberEmail", password: "$memberPassword" })
})
.expect(status: 401)
