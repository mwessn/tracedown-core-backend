// Password reset: request always succeeds (timing-safe)

// Request reset for existing user — always 200
post("$baseUrl/api/v1/auth/password-reset", {
  body: json({ email: "$adminEmail" })
})
.expect(status: 200)

// Request reset for non-existent user — also 200 (no enumeration)
post("$baseUrl/api/v1/auth/password-reset", {
  body: json({ email: "nobody@example.com" })
})
.expect(status: 200)

// Empty email rejected
post("$baseUrl/api/v1/auth/password-reset", {
  body: json({ email: "" })
})
.expect(status: 400)

// Invalid token rejected
post("$baseUrl/api/v1/auth/password-reset/confirm", {
  body: json({ token: "invalid-token", newPassword: "NewPass123!" })
})
.expect(status: 400)

// Empty token rejected
post("$baseUrl/api/v1/auth/password-reset/confirm", {
  body: json({ token: "", newPassword: "NewPass123!" })
})
.expect(status: 400)
