// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create a new group
post("$baseUrl/api/v1/groups", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "Engineers" })
})
.expect(status: 200)
.assert({
  expect: [
    this.body.name eq "Engineers",
    this.body.memberCount eq 0
  ]
})
