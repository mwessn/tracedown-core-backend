// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create group
post("$baseUrl/api/v1/groups", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "DuplicateTest" })
})
.expect(status: 200)

// Try to create same name again
post("$baseUrl/api/v1/groups", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "DuplicateTest" })
})
.expect(status: 409)
