// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// List groups — should include default groups (Admins, Users, Viewers, DevOps)
get("$baseUrl/api/v1/groups", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
