// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create group
post("$baseUrl/api/v1/groups", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "InvalidLevelTest" })
})
.expect(status: 200)
.store({ "$$groupId": this.body.id })

// Invalid access level (5 is not 0/1/2)
patch("$baseUrl/api/v1/groups/$$groupId", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ users: 5 })
})
.expect(status: 400)
