// Metrics: returns 404 when no metric data exists for a service

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create workspace → project → service
post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "MetricsTestWs" })
})
.expect(status: 200)
.store({ "$$wsId": this.body.id })

post("$baseUrl/api/v1/projects", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ workspaceId: "$$wsId", name: "MetricsTestProj" })
})
.expect(status: 200)
.store({ "$$projId": this.body.id })

post("$baseUrl/api/v1/services", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ projectId: "$$projId", name: "Metrics Test Svc" })
})
.expect(status: 200)
.store({ "$$svcId": this.body.id })

// No probe results exist, so metrics should return 204 No Content
get("$baseUrl/api/v1/services/$$svcId/metrics", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 204)
