// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Update org name
patch("$baseUrl/api/v1/org/settings", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "Renamed Org" })
})
.expect(status: 200)
.assert({ expect: [this.body.name eq "Renamed Org"] })
