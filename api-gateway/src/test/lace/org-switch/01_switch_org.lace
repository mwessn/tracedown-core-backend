// Login as admin (in default org)
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Switch to secondOrg
post("$baseUrl/api/v1/auth/switch-org", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ orgId: "$secondOrgOrgId" })
})
.expect(status: 200)
.store({ "$$newToken": this.body.token })

// Verify new session works
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$newToken" }
})
.expect(status: 200)

// Old token should be revoked
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 401)

// Switch back to default
post("$baseUrl/api/v1/auth/switch-org", {
  headers: { Authorization: "Bearer $$newToken" },
  body: json({ orgId: "$defaultOrgId" })
})
.expect(status: 200)
