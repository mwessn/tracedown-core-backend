// Auth tier (login): 3 requests allowed, 4th should be 429

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "nobody@test.com", password: "wrong" })
})
.expect(status: 401)

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "nobody@test.com", password: "wrong" })
})
.expect(status: 401)

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "nobody@test.com", password: "wrong" })
})
.expect(status: 401)

// 4th request exceeds auth tier limit
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "nobody@test.com", password: "wrong" })
})
.expect(status: 429)
