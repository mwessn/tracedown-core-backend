// Password reset uses the auth tier (3 requests), 4th should be 429

post("$baseUrl/api/v1/auth/password-reset", {
  body: json({ email: "nobody@test.com" })
})
.expect(status: 200)

post("$baseUrl/api/v1/auth/password-reset", {
  body: json({ email: "nobody@test.com" })
})
.expect(status: 200)

post("$baseUrl/api/v1/auth/password-reset", {
  body: json({ email: "nobody@test.com" })
})
.expect(status: 200)

// 4th request exceeds auth tier limit
post("$baseUrl/api/v1/auth/password-reset", {
  body: json({ email: "nobody@test.com" })
})
.expect(status: 429)
