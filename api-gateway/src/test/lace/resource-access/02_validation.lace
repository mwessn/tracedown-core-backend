// Access-grant validation: resource type, permission level, and principal.

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "AccessValWs" })
})
.expect(status: 200)
.store({ "$$wsId": this.body.id })

// Unknown resource type.
put("$baseUrl/api/v1/access/banana/$$wsId", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ principalType: "user", principalId: "$memberId", permissions: 1 })
})
.expect(status: 400)

// Permission level out of range (must be 1 or 2).
put("$baseUrl/api/v1/access/workspace/$$wsId", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ principalType: "user", principalId: "$memberId", permissions: 3 })
})
.expect(status: 400)

// Granting to a principal that is not a member of the org.
put("$baseUrl/api/v1/access/workspace/$$wsId", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ principalType: "user", principalId: "00000000-0000-0000-0000-000000000000", permissions: 1 })
})
.expect(status: 404)
