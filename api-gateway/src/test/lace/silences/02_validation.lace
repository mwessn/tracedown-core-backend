// Notification silence validation errors

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Invalid channel
post("$baseUrl/api/v1/silences", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ channel: "sms" })
})
.expect(status: 400)

// Multiple scopes set
post("$baseUrl/api/v1/silences", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ channel: "all", workspaceId: "00000000-0000-0000-0000-000000000001", projectId: "00000000-0000-0000-0000-000000000002" })
})
.expect(status: 400)

// Non-existent workspace
post("$baseUrl/api/v1/silences", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ channel: "all", workspaceId: "00000000-0000-0000-0000-000000000099" })
})
.expect(status: 404)
