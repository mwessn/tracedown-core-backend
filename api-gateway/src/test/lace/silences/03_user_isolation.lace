// Silences are per-user: member cannot see admin's silences

// Login as admin and create a silence
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$adminToken": this.body.token })

post("$baseUrl/api/v1/silences", {
  headers: { Authorization: "Bearer $$adminToken" },
  body: json({ channel: "all" })
})
.expect(status: 200)
.store({ "$$adminSilenceId": this.body.id })

// Login as member
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$memberEmail", password: "$memberPassword" })
})
.expect(status: 200)
.store({ "$$memberToken": this.body.token })

// Member's silence list is empty (admin's silence not visible)
get("$baseUrl/api/v1/silences", {
  headers: { Authorization: "Bearer $$memberToken" }
})
.expect(status: 200)
.assert({ expect: [this.body.total eq 0] })

// Member cannot access admin's silence directly
get("$baseUrl/api/v1/silences/$$adminSilenceId", {
  headers: { Authorization: "Bearer $$memberToken" }
})
.expect(status: 404)

// Member cannot delete admin's silence
delete("$baseUrl/api/v1/silences/$$adminSilenceId", {
  headers: { Authorization: "Bearer $$memberToken" }
})
.expect(status: 404)
