// Usage endpoints return the usage shape at every scope (zeros on a fresh org).

// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create workspace -> project -> service
post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "UsageWs" })
})
.expect(status: 200)
.store({ "$$wsId": this.body.id })

post("$baseUrl/api/v1/projects", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ workspaceId: "$$wsId", name: "UsageProj" })
})
.expect(status: 200)
.store({ "$$projId": this.body.id })

post("$baseUrl/api/v1/services", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ projectId: "$$projId", name: "UsageSvc" })
})
.expect(status: 200)
.store({ "$$svcId": this.body.id })

// Service usage — validate the response shape and the coerced window.
get("$baseUrl/api/v1/services/$$svcId/usage?hours=24", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200, body: schema($usageSchema))
.assert({ expect: [this.body.windowHours eq 24, this.body.requests eq 0] })

// Project, workspace, and org-wide usage share the same shape.
get("$baseUrl/api/v1/projects/$$projId/usage?hours=24", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200, body: schema($usageSchema))

get("$baseUrl/api/v1/workspaces/$$wsId/usage?hours=24", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200, body: schema($usageSchema))

get("$baseUrl/api/v1/org/usage?hours=24", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200, body: schema($usageSchema))
