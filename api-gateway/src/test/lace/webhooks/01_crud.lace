// Full webhook CRUD lifecycle

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create webhook
post("$baseUrl/api/v1/webhooks", {
  headers: { Authorization: "Bearer $$token" },
  body: json({
    name: "Slack Alert",
    url: "https://hooks.slack.com/services/T00/B00/xxx",
    method: "POST",
    label: "alerts",
    attemptCount: 3
  })
})
.expect(status: 200)
.assert({
  expect: [
    this.body.name eq "Slack Alert",
    this.body.url eq "https://hooks.slack.com/services/T00/B00/xxx",
    this.body.method eq "POST",
    this.body.label eq "alerts",
    this.body.attemptCount eq 3
  ]
})
.store({ "$$whId": this.body.id })

// Create second webhook with GET method
post("$baseUrl/api/v1/webhooks", {
  headers: { Authorization: "Bearer $$token" },
  body: json({
    name: "Health Ping",
    url: "https://healthcheck.io/ping/abc",
    method: "GET"
  })
})
.expect(status: 200)
.assert({
  expect: [
    this.body.method eq "GET",
    this.body.label eq null
  ]
})
.store({ "$$whId2": this.body.id })

// List webhooks
get("$baseUrl/api/v1/webhooks", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)

// Get single webhook
get("$baseUrl/api/v1/webhooks/$$whId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.name eq "Slack Alert"] })

// Update webhook
patch("$baseUrl/api/v1/webhooks/$$whId", {
  headers: { Authorization: "Bearer $$token" },
  body: json({
    name: "Slack Alert v2",
    url: "https://hooks.slack.com/services/T00/B00/yyy",
    attemptCount: 5
  })
})
.expect(status: 200)
.assert({
  expect: [
    this.body.name eq "Slack Alert v2",
    this.body.url eq "https://hooks.slack.com/services/T00/B00/yyy",
    this.body.attemptCount eq 5
  ]
})

// Delete webhook
delete("$baseUrl/api/v1/webhooks/$$whId2", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)

// Verify deleted webhook is gone
get("$baseUrl/api/v1/webhooks/$$whId2", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 404)
