// Test: invalid variable type is rejected

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create workspace
post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "InvalidTypeTest" })
})
.expect(status: 200)
.store({ "$$wsId": this.body.id })

// Invalid type should return 400
post("$baseUrl/api/v1/workspaces/$$wsId/variables", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ key: "BAD", value: "x", type: "invalid" })
})
.expect(status: 400)
