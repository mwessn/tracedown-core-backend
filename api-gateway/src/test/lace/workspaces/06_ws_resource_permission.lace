// Test: member with write grant on workspace A can manage its variables,
// but cannot access workspace B

// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$adminToken": this.body.token })

// Create two workspaces
post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$adminToken" },
  body: json({ name: "WsGranted" })
})
.expect(status: 200)
.store({ "$$grantedWsId": this.body.id })

post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$adminToken" },
  body: json({ name: "WsDenied" })
})
.expect(status: 200)
.store({ "$$deniedWsId": this.body.id })

// Grant member write on WsGranted only
patch("$baseUrl/api/v1/users/$memberId/permissions", {
  headers: { Authorization: "Bearer $$adminToken" },
  body: json({
    resources: [
      { resourceType: "workspace", resourceId: "$$grantedWsId", permissions: 2 }
    ]
  })
})
.expect(status: 200)

// Login as member
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$memberEmail", password: "$memberPassword" })
})
.expect(status: 200)
.store({ "$$memberToken": this.body.token })

// Member can create variable on granted workspace
post("$baseUrl/api/v1/workspaces/$$grantedWsId/variables", {
  headers: { Authorization: "Bearer $$memberToken" },
  body: json({ key: "GRANTED_VAR", value: "works", type: "metric" })
})
.expect(status: 200)
.assert({ expect: [this.body.value eq "works"] })

// Member cannot access denied workspace (404 — no grant = not found)
get("$baseUrl/api/v1/workspaces/$$deniedWsId", {
  headers: { Authorization: "Bearer $$memberToken" }
})
.expect(status: 404)
